# Copia questo file in .env (in locale) oppure imposta le variabili nel pannello dell'hosting.
# Password del backend (/admin). In produzione (NODE_ENV=production) deve avere almeno 8 caratteri e non essere "prosecco",
# altrimenti il backend resta disattivato.
ADMIN_PASSWORD=cambiami-subito
# Porta del server (in hosting la imposta la piattaforma)
# PORT=5800
# Cartelle su disco persistente (hosting): al primo avvio vengono riempite con i dati del repository
# DATA_DIR=/var/dati/data
# UPLOADS_DIR=/var/dati/uploads
